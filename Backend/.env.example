APP_ENV=development

# MySQL 8 — URL-encode special characters in the password (@ -> %40, # -> %23)
DATABASE_URL=mysql+pymysql://root:YOUR_MYSQL_PASSWORD@localhost:3306/great_footwear?charset=utf8mb4

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
COOKIE_SECURE=false
# Android app: COOKIE_SAMESITE=none, COOKIE_SECURE=true, add https://localhost to CORS_ORIGINS
# and set MEDIA_URL to an absolute URL (https://api.example.com/media) so images load in the app
COOKIE_SAMESITE=lax

FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173

# Razorpay — keys live only here (PY-12). Test/live switch is in Admin → Settings.
RAZORPAY_TEST_KEY_ID=
RAZORPAY_TEST_KEY_SECRET=
RAZORPAY_LIVE_KEY_ID=
RAZORPAY_LIVE_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Email (leave SMTP_HOST empty to print emails in the server log)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=Great Foot Wear <no-reply@greatfootwear.in>
SMTP_TLS=true

# SMS: "console" prints OTP / SMS in the server log
SMS_PROVIDER=console

# Image storage: local | s3 | cloudinary
STORAGE_BACKEND=local
MEDIA_DIR=media
MEDIA_URL=/media
# S3 (or S3-compatible). S3_PUBLIC_BASE_URL = CDN base, e.g. https://dxxxx.cloudfront.net
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=
S3_KEY_PREFIX=media
# Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=great-footwear

# Google sign-in (OAuth 2.0 Web client ID; add your site URL to "Authorized JavaScript origins")
GOOGLE_CLIENT_ID=

# Shiprocket API user (Shiprocket panel → Settings → API → Configure) and webhook token
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=

# First Super Admin (created by seed.py, must change password on first login)
SUPERADMIN_NAME=Owner
SUPERADMIN_EMAIL=owner@greatfootwear.in
SUPERADMIN_MOBILE=9385938581
SUPERADMIN_PASSWORD=ChangeMe123
